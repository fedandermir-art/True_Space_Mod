{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fedandermir-art/True_Space_Mod/content/schema/registry.schema.json",
  "title": "True Space Mod — design-time content registry entry",
  "description": "Schema for a single entry of the design-time content registry. The registry documents EVERY piece of content (item, block, fluid, machine...) together with its real-world basis, before/in parallel with the code. It is NOT loaded by the game.",
  "type": "object",
  "required": ["id", "type", "status", "name", "description"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_/]{1,127}$",
      "description": "Unique identifier. For in-game content it must equal the in-game id (truespace:...)."
    },
    "type": {
      "type": "string",
      "enum": ["material", "item", "block", "fluid", "machine", "component", "world", "mob", "mechanic", "system"],
      "description": "Broad content category."
    },
    "status": {
      "type": "string",
      "enum": ["planned", "designed", "implemented", "placeholder"],
      "description": "planned = idea; designed = has full real-world data and recipe; implemented = exists in code; placeholder = temporary stub."
    },
    "tier": {
      "type": "string",
      "description": "Progression tier, e.g. early / mid / late / endgame / orbit / interplanetary."
    },
    "name": {
      "$ref": "#/definitions/localized"
    },
    "description": {
      "$ref": "#/definitions/localized"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "realWorld": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basis": {
          "type": "string",
          "description": "What real object/process this is based on."
        },
        "source": {
          "type": "string",
          "description": "URL or citation (NASA/ESA/textbook)."
        },
        "data": {
          "type": "object",
          "description": "Real measured values (density, melting point, Isp, boiling point...). Keys are free-form.",
          "additionalProperties": { "type": ["number", "string"] }
        }
      }
    },
    "recipe": {
      "type": "object",
      "description": "Design-time recipe description. The real in-game recipe is generated by datagen and must match this.",
      "additionalProperties": false,
      "properties": {
        "machine": { "type": "string", "description": "Machine id that performs the process, or 'crafting' / 'smelting'." },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/stack" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/stack" }
        },
        "byproducts": {
          "type": "array",
          "items": { "$ref": "#/definitions/stack" }
        },
        "note": { "type": "string" }
      }
    },
    "depends": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ids this entry depends on (prerequisites)."
    },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Related ids (cross-references)."
    }
  },
  "definitions": {
    "localized": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string" },
        "ru": { "type": "string" }
      }
    },
    "stack": {
      "type": "object",
      "required": ["item"],
      "additionalProperties": false,
      "properties": {
        "item": { "type": "string" },
        "amount": { "type": "number" }
      }
    }
  }
}
